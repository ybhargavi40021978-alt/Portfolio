# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Frontend / CORS Origin
FRONTEND_URL=http://localhost:5000

# Private Admin Key for Analytics Stats Endpoint (GET /api/analytics/stats)
ADMIN_API_KEY=portfolio_admin_secret_2026

# Email Service Configuration (Optional)
EMAIL_SERVICE_ENABLED=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_RECIPIENT=your_recipient@example.com
